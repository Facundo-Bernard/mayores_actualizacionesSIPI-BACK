# Servidor (para Docker/IIS Proxy)
PORT=3000

# Frontend URL (para CORS y enlaces de correo)
FRONTEND_URL=http://mayoresactualizaciones.duckdns.org

# Base de datos MySQL
# Para Docker: usa host.docker.internal para DB en host
# Para producción: usa la IP del servidor de DB
SPRING_DATASOURCE_URL=jdbc:mysql://host.docker.internal:3306/prueba2?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=admin

