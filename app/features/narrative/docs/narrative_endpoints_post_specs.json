    "6_conversaciones": {
      "entidad": "Diálogo de Corte",
      "metodo": "POST",
      "url": "/api/narrative/admin/conversaciones",
      "descripcion": "Crea o actualiza una disputa/conversación entre 2 personajes de corte con opciones de arbitraje del monarca.",
      "campos": {
        "_id": { "tipo": "string", "requerido": true, "descripcion": "ID único (ej: conv_disputa_tesoro_militar)" },
        "universo_id": { "tipo": "string", "requerido": true, "descripcion": "ID del universo" },
        "titulo": { "tipo": "string", "requerido": true, "descripcion": "Título del dilema de corte" },
        "imagen": { "tipo": "string", "requerido": true, "descripcion": "URL o ruta de fondo de la conversación" },
        "requisitos": {
          "tipo": "array",
          "requerido": true,
          "descripcion": "Lista de personajes que deben estar en la corte activa (exactamente 2)",
          "items": {
            "personajeId": { "tipo": "string", "requerido": true, "descripcion": "ID del personaje requerido" }
          }
        },
        "frases": {
          "tipo": "array",
          "requerido": true,
          "descripcion": "Guion secuencial de diálogo",
          "items": {
            "personajeId": { "tipo": "string", "requerido": true, "descripcion": "Personaje que habla" },
            "texto": { "tipo": "string", "requerido": true, "descripcion": "Línea de diálogo" }
          }
        },
        "decisiones": {
          "tipo": "array",
          "requerido": true,
          "descripcion": "Opciones de intervención del jugador",
          "items": {
            "opcion": { "tipo": "integer", "requerido": true, "descripcion": "Número ordinal (1, 2, 3)" },
            "texto": { "tipo": "string", "requerido": true, "descripcion": "Decisión tomada por el jugador" },
            "condiciones": { "tipo": "array", "requerido": false, "default": [], "descripcion": "Condiciones opcionales" },
            "resultado_texto": { "tipo": "string", "requerido": true, "descripcion": "Respuesta narrativa de la corte" },
            "impacto_afinidad": {
              "tipo": "array",
              "requerido": false,
              "default": [],
              "items": {
                "personaje_id": { "tipo": "string", "requerido": true, "descripcion": "Personaje afectado" },
                "delta": { "tipo": "integer", "requerido": true, "descripcion": "Cambio en afinidad (+15, -10)" }
              }
            }
          }
        }
      },
      "ejemplo_payload": {
        "_id": "conv_disputa_tesoro_militar",
        "universo_id": "corte_medieval",
        "titulo": "Presupuesto de Campaña Militar",
        "imagen": "/assets/narrative/conversations/sala_reuniones.webp",
        "requisitos": [
          { "personajeId": "pj_canciller_elena" },
          { "personajeId": "pj_comandante_marcus" }
        ],
        "frases": [
          {
            "personajeId": "pj_comandante_marcus",
            "texto": "Mis hombres necesitan mejores armaduras y raciones si queremos mantener segura la frontera norte."
          },
          {
            "personajeId": "pj_canciller_elena",
            "texto": "Si desviamos más oro a la guarnición, asfixiaremos el comercio y los gremios se rebelarán."
          }
        ],
        "decisiones": [
          {
            "opcion": 1,
            "texto": "Respaldar a Elena: la prudencia fiscal es prioridad ante el invierno",
            "condiciones": [],
            "resultado_texto": "Marcus aprieta la mandíbula y acata la orden con evidente desagrado.",
            "impacto_afinidad": [
