            }
          }
        ],
        "impacto_afinidad": [
          { "personaje_id": "pj_canciller_elena", "delta": 10 }
        ]
      }
    },
    "5_eventos": {
      "entidad": "Evento Mensual",
      "metodo": "POST",
      "url": "/api/narrative/admin/eventos",
      "descripcion": "Crea o actualiza un evento con árbol de decisiones, opciones secretas y desenlaces probabilísticos.",
      "campos": {
        "_id": { "tipo": "string", "requerido": true, "descripcion": "ID único (ej: evt_helada_cosechas)" },
        "universo_id": { "tipo": "string", "requerido": true, "descripcion": "ID del universo" },
        "titulo": { "tipo": "string", "requerido": true, "descripcion": "Nombre del dilema" },
        "descripcion": { "tipo": "string", "requerido": true, "descripcion": "Contexto del evento" },
        "imagen": { "tipo": "string", "requerido": true, "descripcion": "Imagen ilustrativa" },
        "tags_tematicos": { "tipo": "array de strings", "requerido": false, "default": [], "descripcion": "Categorías" },
        "peso_base": { "tipo": "number", "requerido": false, "default": 100.0, "descripcion": "Probabilidad relativa de sorteo mensual" },
        "opciones": {
          "tipo": "array",
          "requerido": true,
          "descripcion": "Lista de opciones que se le presentan al jugador",
          "items": {
            "id": { "tipo": "string", "requerido": true, "descripcion": "Identificador de la opción (op_a, op_b, op_c)" },
            "texto": { "tipo": "string", "requerido": true, "descripcion": "Texto visible de la decisión" },
            "es_secreta": { "tipo": "boolean", "requerido": false, "default": false, "descripcion": "Si es secreta, requiere condiciones cumplidas" },
            "condiciones": { "tipo": "array", "requerido": false, "default": [], "descripcion": "Condiciones para desbloquear" },
            "resultados_posibles": {
              "tipo": "array",
              "requerido": true,
              "descripcion": "Desenlaces vinculados con pesos",
              "items": {
                "resultado_id": { "tipo": "string", "requerido": true, "descripcion": "ID de un resultado existente" },
                "peso_base": { "tipo": "number", "requerido": false, "default": 50.0, "descripcion": "Peso base" },
                "modificadores_probabilidad": {
                  "tipo": "array",
                  "requerido": false,
                  "default": [],
                  "items": {
                    "condicion": { "tipo": "object", "requerido": true, "descripcion": "Condición para aplicar delta" },
                    "delta_peso": { "tipo": "number", "requerido": true, "descripcion": "Variación de peso (+35, -20)" },
                    "explicacion": { "tipo": "string", "requerido": false, "descripcion": "Texto para tooltip del alumno" }
                  }
                }
              }
            }
          }
        }
      },
