{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "metadata": {
    "titulo": "Especificación de Endpoints POST - Motor Narrativo Roguelite",
    "version": "1.0.0",
    "fecha_actualizacion": "2026-10-15",
    "base_url_desarrollo": "http://localhost:8080",
    "base_url_produccion": "/api/narrative",
    "headers_requeridos": {
      "Content-Type": "application/json",
      "Authorization": "Bearer <JWT_TOKEN>"
    },
    "notas_importantes": [
      "El campo '_id' o 'id' representa la clave primaria única de cada entidad.",
      "Todos los campos numéricos de afinidad manejan rango de 0 a 100 (50 por defecto).",
      "El patrón ECA (Event - Condition - Action) es compartido por Personajes, Cartas, Desenlaces y Eventos.",
      "Para los endpoints de administración, todas las referencias relacionales (universo_id, personajeId, resultado_id) deben existir previamente en la base de datos."
    ]
  },
  "catalogo_enums": {
    "disparador": {
      "al_obtener": "Se dispara inmediatamente al añadir la carta al mazo o reclutar al personaje",
      "cada_mes": "Se evalúa al inicio de cada mes (fase de balance)",
      "en_evento_positivo": "Se activa tras obtener un resultado positivo en el evento mensual",
      "en_evento_negativo": "Se activa tras obtener un resultado negativo en el evento mensual",
      "al_final_partida": "Se evalúa al concluir el Mes 12 (cálculo de epílogo)"
    },
    "operador": {
      ">=": "Mayor o igual",
      "<=": "Menor o igual",
      ">": "Mayor estricto",
      "<": "Menor estricto",
      "==": "Igual exacto",
      "!=": "Distinto"
    },
    "tipo_condicion": {
      "comparar_recurso": "Compara un recurso del reino (clave, operador, valor)",
      "tiene_personaje": "Verifica si un personaje específico está en la corte activa (personaje_id)",
      "afinidad_personaje": "Compara el nivel de afinidad con un personaje (personaje_id, operador, valor)",
      "tiene_tag": "Verifica si el reino tiene un tag pasivo activo (tag)",
      "tiene_carta": "Verifica si una carta está en el inventario del jugador (carta_id)"
    },
    "tipo_accion": {
      "modificar_recurso": "Modifica un recurso numérico del reino (clave, valor, tipo_calculo)",
      "modificar_afinidad": "Modifica la afinidad con un personaje (personaje_id, valor)",
      "otorgar_tag": "Añade un tag permanente al estado del reino (tag)",
      "amortiguar_danio": "Reduce el impacto negativo recibido sobre un recurso (clave, valor)"
    },
    "tipo_calculo": {
      "fijo": "Modificación numérica directa (+10, -5, +20)",
      "porcentual": "Modificación porcentual (+15%, -20%)"
    },
    "categoria_carta": {
      "item": "Objeto o reliquia de apoyo",
      "bonus": "Modificador global de reglas",
      "personaje": "Recluta o aliado de soporte"
    },
    "tipo_resultado": {
      "positivo": "Desenlace favorable (generalmente suma recursos/afinidad)",
      "negativo": "Desenlace desfavorable (resta recursos/afinidad o añade crisis)",
      "neutro": "Desenlace de balance o compensación mixta"
    }
  },
  "bloque_eca_reutilizable": {
    "descripcion": "Estructura estándar de un efecto o pasiva",
    "schema": {
      "disparador": "al_obtener | cada_mes | en_evento_positivo | en_evento_negativo | al_final_partida",
      "condiciones": [
        {
          "tipo": "comparar_recurso | tiene_personaje | afinidad_personaje | tiene_tag | tiene_carta",
          "clave": "nombre del recurso o null",
          "operador": ">= | <= | > | < | == | != o null",
          "valor": "número o texto o null",
          "personaje_id": "ID del personaje o null",
          "carta_id": "ID de la carta o null",
          "tag": "nombre del tag o null"
        }
      ],
      "accion": {
        "tipo": "modificar_recurso | modificar_afinidad | otorgar_tag | amortiguar_danio",
        "clave": "recurso afectado o null",
        "tipo_calculo": "fijo | porcentual",
        "valor": "número flotante o entero",
        "personaje_id": "ID del personaje afectado o null",
        "tag": "tag a otorgar o null"
      }
    }
  },
  "endpoints_admin": {
    "1_universos": {
      "entidad": "Universo / Temática",
      "metodo": "POST",
      "url": "/api/narrative/admin/universos",
      "descripcion": "Crea o actualiza un universo temático definiendo sus recursos vitales.",
      "campos": {
        "_id": { "tipo": "string", "requerido": true, "descripcion": "Identificador alfanumérico único" },
        "nombre": { "tipo": "string", "requerido": true, "descripcion": "Nombre público del universo" },
        "descripcion": { "tipo": "string", "requerido": true, "descripcion": "Sinopsis de la ambientación" },
        "icono": { "tipo": "string", "requerido": false, "default": "crown", "descripcion": "Identificador de ícono SVG" },
        "recursos": {
          "tipo": "array",
          "requerido": true,
          "descripcion": "Lista de recursos vitales que gestionará el jugador",
          "items": {
            "clave": { "tipo": "string", "requerido": true, "descripcion": "Clave única del recurso (ej: oro)" },
            "nombre": { "tipo": "string", "requerido": true, "descripcion": "Nombre visible (ej: Tesoro Real)" },
            "icono": { "tipo": "string", "requerido": false, "default": "coins", "descripcion": "Ícono del recurso" },
            "min": { "tipo": "integer", "requerido": false, "default": 0, "descripcion": "Límite inferior" },
            "max": { "tipo": "integer", "requerido": false, "default": 100, "descripcion": "Límite superior" },
            "inicial": { "tipo": "integer", "requerido": false, "default": 50, "descripcion": "Valor con el que inicia la partida" }
          }
        }
      },
      "ejemplo_payload": {
        "_id": "corte_medieval",
        "nombre": "Crónicas de la Corte Real",
        "descripcion": "Gobierna un reino feudal al borde de la rebelión y el invierno perpetuo.",
        "icono": "crown",
        "recursos": [
          { "clave": "oro", "nombre": "Tesoro Real", "icono": "coins", "min": 0, "max": 100, "inicial": 50 },
          { "clave": "comida", "nombre": "Graneros del Valle", "icono": "wheat", "min": 0, "max": 100, "inicial": 50 },
          { "clave": "orden", "nombre": "Paz y Guardia Civil", "icono": "shield", "min": 0, "max": 100, "inicial": 50 },
          { "clave": "moral", "nombre": "Aprobación del Pueblo", "icono": "heart", "min": 0, "max": 100, "inicial": 50 }
        ]
      }
    },
    "2_personajes": {
      "entidad": "Personaje de Corte",
      "metodo": "POST",
      "url": "/api/narrative/admin/personajes",
      "descripcion": "Crea o actualiza un miembro de corte reclutable por el jugador.",
      "campos": {
        "_id": { "tipo": "string", "requerido": true, "descripcion": "ID único del personaje (ej: pj_canciller_elena)" },
        "universo_id": { "tipo": "string", "requerido": true, "descripcion": "ID del universo al que pertenece" },
        "nombre": { "tipo": "string", "requerido": true, "descripcion": "Nombre de pila" },
        "titulo": { "tipo": "string", "requerido": true, "descripcion": "Cargo o rol (ej: Canciller de la Moneda)" },
        "imagen": { "tipo": "string", "requerido": true, "descripcion": "Ruta o URL de retrato" },
        "descripcion": { "tipo": "string", "requerido": true, "descripcion": "Biografía y motivaciones" },
        "pros": { "tipo": "array de strings", "requerido": false, "default": [], "descripcion": "Ventajas visibles" },
        "cons": { "tipo": "array de strings", "requerido": false, "default": [], "descripcion": "Desventajas visibles" },
        "tags": { "tipo": "array de strings", "requerido": false, "default": [], "descripcion": "Tags temáticos" },
        "afinidad_inicial": { "tipo": "integer", "requerido": false, "default": 50, "descripcion": "Afinidad base (0-100)" },
        "efectos": { "tipo": "array", "requerido": false, "default": [], "descripcion": "Reglas pasivas ECA" },
        "conversaciones": { "tipo": "array", "requerido": false, "default": [], "descripcion": "Pesos para diálogos" }
      },
      "ejemplo_payload": {
        "_id": "pj_canciller_elena",
        "universo_id": "corte_medieval",
        "nombre": "Elena",
        "titulo": "Canciller de la Moneda",
        "imagen": "/assets/narrative/characters/canciller.webp",
        "descripcion": "Diplomática calculadora. Protege las arcas reales con mano firme.",
        "pros": ["Genera +10 de oro en balance mensual", "Reduce costos de sobornos"],
        "cons": ["Resta 5 de moral si el tesoro supera 80"],
        "tags": ["finanzas", "diplomacia", "noble"],
        "afinidad_inicial": 50,
        "efectos": [
          {
            "disparador": "cada_mes",
            "condiciones": [],
            "accion": {
              "tipo": "modificar_recurso",
              "clave": "oro",
              "tipo_calculo": "fijo",
              "valor": 10.0
            }
          }
        ],
        "conversaciones": [
          { "idConversacion": "conv_disputa_tesoro_militar", "probabilidad": 0.35 }
        ]
      }
    },
    "3_cartas": {
      "entidad": "Carta de Apoyo",
      "metodo": "POST",
      "url": "/api/narrative/admin/cartas",
      "descripcion": "Crea o actualiza una carta de apoyo (ítem, bonificación o recluta).",
      "campos": {
        "_id": { "tipo": "string", "requerido": true, "descripcion": "ID único (ej: carta_sello_real)" },
        "universo_id": { "tipo": "string", "requerido": true, "descripcion": "ID del universo" },
        "categoria": { "tipo": "string", "requerido": true, "enum": ["item", "bonus", "personaje"], "descripcion": "Tipo de carta" },
        "nombre": { "tipo": "string", "requerido": true, "descripcion": "Nombre de la carta" },
        "descripcion": { "tipo": "string", "requerido": true, "descripcion": "Efecto o leyenda" },
        "imagen": { "tipo": "string", "requerido": true, "descripcion": "URL o ruta de imagen" },
        "tags": { "tipo": "array de strings", "requerido": false, "default": [], "descripcion": "Tags que otorga" },
        "efectos": { "tipo": "array", "requerido": false, "default": [], "descripcion": "Reglas pasivas ECA" }
      },
      "ejemplo_payload": {
        "_id": "carta_sello_real",
        "universo_id": "corte_medieval",
        "categoria": "item",
        "nombre": "Sello Real de Cera",
        "descripcion": "Autoriza decretos indiscutibles y desbloquea opciones secretas en eventos.",
        "imagen": "/assets/narrative/cards/sello_real.webp",
        "tags": ["sello_real", "legitimidad"],
        "efectos": [
          {
            "disparador": "al_obtener",
            "condiciones": [],
            "accion": {
              "tipo": "otorgar_tag",
              "tag": "sello_real"
            }
          }
        ]
      }
    },
    "4_resultados": {
      "entidad": "Desenlace / Resultado Posible",
      "metodo": "POST",
      "url": "/api/narrative/admin/resultados",
      "descripcion": "Crea o actualiza una consecuencia de evento con impacto en recursos y afinidad.",
      "campos": {
        "_id": { "tipo": "string", "requerido": true, "descripcion": "ID único (ej: res_suministros_asegurados)" },
        "universo_id": { "tipo": "string", "requerido": true, "descripcion": "ID del universo" },
        "titulo": { "tipo": "string", "requerido": true, "descripcion": "Título del desenlace" },
        "texto": { "tipo": "string", "requerido": true, "descripcion": "Narración de lo sucedido" },
        "imagen": { "tipo": "string", "requerido": true, "descripcion": "Ilustración del resultado" },
        "tipo_resultado": { "tipo": "string", "requerido": false, "default": "neutro", "enum": ["positivo", "negativo", "neutro"] },
        "efectos": { "tipo": "array", "requerido": false, "default": [], "descripcion": "Efectos sobre recursos (disparador 'al_obtener')" },
        "impacto_afinidad": {
          "tipo": "array",
          "requerido": false,
          "default": [],
          "items": {
            "personaje_id": { "tipo": "string", "requerido": true, "descripcion": "ID del personaje" },
            "delta": { "tipo": "integer", "requerido": true, "descripcion": "Cambio numérico (+15, -10)" }
          }
        }
      },
      "ejemplo_payload": {
